# GrowLocal backend — copy to .env and adjust.
# Dev defaults run fully offline: no Gemini key, no Firebase project needed.

# --- AI ---
GEMINI_API_KEY=            # leave empty in dev (GEMINI_MOCK=true); paste key for real calls
GEMINI_MODEL=gemini-2.5-flash

# --- External data (P1) ---
GOOGLE_PLACES_API_KEY=     # optional; /api/places returns [] without it

# --- Firebase ---
FIREBASE_PROJECT_ID=       # e.g. growlocal-demo

# --- App ---
ALLOWED_ORIGIN=http://localhost:3000

# --- Dev-mode switches (production must set all three to real behavior) ---
AUTH_DISABLED=true         # true: skip Firebase token check, use dev-user
GEMINI_MOCK=true           # true: canned valid response, no live Gemini call
STORE_BACKEND=memory       # memory | firestore
